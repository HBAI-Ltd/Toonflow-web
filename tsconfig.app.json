{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["src/**/*", "src/**/*.vue"],
  "exclude": ["src/views/scriptAgent/index copy.vue"],
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "**/*.test.ts",
    "src/**/__tests__/*",
    "src/views/production/components/workbench/generate copy.vue",
    "src/views/production/components/workbench/generate copy"
  ]
}